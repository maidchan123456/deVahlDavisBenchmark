FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      rho;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -3 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    hotWall
    {
        type            calculated;
        value           uniform 0.99995;
    }
    coldWall
    {
        type            calculated;
        value           uniform 1.00005;
    }
    bottomWall
    {
        type            calculated;
        value           uniform 1;
    }
    topWall
    {
        type            calculated;
        value           uniform 1;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}


