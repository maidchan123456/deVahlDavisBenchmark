FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    hotWall
    {
        type            noSlip;
    }
    coldWall
    {
        type            noSlip;
    }
    bottomWall
    {
        type            noSlip;
    }
    topWall
    {
        type            noSlip;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    procBoundary6to8
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary6to10
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary6to11
    {
        type            processor;
        value           uniform (0 0 0);
    }
}


